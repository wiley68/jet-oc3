{{ header }}{{ column_left }}
<div id="content">
    
    {% if error_warning %}
    <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <button type="submit" form="form-html" data-toggle="tooltip" title="Запиши" class="btn btn-primary"><i class="fa fa-save"></i></button>
                <a href="{{ cancel }}" data-toggle="tooltip" title="Отказ" class="btn btn-default"><i class="fa fa-reply"></i></a>
            </div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <div class="container-fluid">
        
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-pencil"></i> Редакция на ПБ Лични Финанси покупки на Кредит</h3>
            </div>
            
            <div class="panel-body">
                
                <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-payment" class="form-horizontal">
                    
                    <div class="form-group">
                        <label class="col-sm-4 control-label" for="input-total"><span data-toggle="tooltip" title="Сума която трябва да бъде надвишена за да се задейства този метод на плащане. Оставете празно ако няма такава.">Минимална сума</span></label>
                        <div class="col-sm-8">
                            <input type="text" name="payment_jet_total" value="{{ payment_jet_total }}" placeholder="{{ entry_total }}" id="input-total" class="form-control" />
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label class="col-sm-4 control-label" for="input-order-status">Състояние на поръчката</label>
                        <div class="col-sm-8">
                            <select name="payment_jet_order_status_id" id="input-order-status" class="form-control">
                                {% for order_status in order_statuses %}
                                {% if order_status.order_status_id == payment_jet_order_status_id %}
                                <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                                {% else %}
                                <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                                {% endif %}
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label class="col-sm-4 control-label" for="input-geo-zone">Зона</label>
                        <div class="col-sm-8">
                            <select name="payment_jet_geo_zone_id" id="input-geo-zone" class="form-control">
                                <option value="0">{{ text_all_zones }}</option>
                                {% for geo_zone in geo_zones %}
                                {% if geo_zone.geo_zone_id == payment_jet_geo_zone_id %}
                                <option value="{{ geo_zone.geo_zone_id }}" selected="selected">{{ geo_zone.name }}</option>
                                {% else %}
                                <option value="{{ geo_zone.geo_zone_id }}">{{ geo_zone.name }}</option>
                                {% endif %}
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label class="col-sm-4 control-label" for="input-status">Състояние</label>
                        <div class="col-sm-8">
                            <select name="payment_jet_status" id="input-status" class="form-control">
                                {% if payment_jet_status %}
                                <option value="1" selected="selected">Включен</option>
                                <option value="0">Изключен</option>
                                {% else %}
                                <option value="1">Включен</option>
                                <option value="0" selected="selected">Изключен</option>
                                {% endif %}
                            </select>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label class="col-sm-4 control-label" for="input-sort-order">Подредба</label>
                        <div class="col-sm-8">
                            <input type="text" name="payment_jet_sort_order" value="{{ payment_jet_sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control" />
                        </div>
                    </div>
                    
                </form>
                
            </div>
        </div>
        
    </div>
</div>
{{ footer }}

	<div class="pull-right">
		<input type="button" disabled value="{{ button_confirm }}" id="button-confirm" class="btn btn-primary" data-loading-text="{{ text_loading }}" />
	</div>
</div>
<script type="text/javascript"><!--
jQuery(document).ready(function($) {
	const $panel = $('#jet_checkout_offer');
	const $confirm = $('#button-confirm');
	const jetConfirmLabel = $confirm.val();
	let jetConfirmPending = false;
	let jetConfirmNeedsReview = false;
	let jetCalculationRevision = 0;
	let jetCurrentOffer = null;
	const jetPanelCurrent = () => {
		const selected = document.querySelector('input[name="payment_method"]:checked');
		return document.getElementById('jet_checkout_offer') === $panel[0] && (!selected || selected.value === 'jet_card');
	};
	const jetCheckoutState = () => JSON.stringify(['price', 'parva', 'vnoski', 'products', 'products_qt', 'products_pr', 'products_vr']
		.map(field => $('#jet_card_' + field).val()));
	const jetOfferCurrent = () => jetPanelCurrent() && jetCurrentOffer !== null && jetCurrentOffer.state === jetCheckoutState();
	let jetSchemeNoticeState = null;
	let jetCloseSchemeDialog = null;
	const previousInformation = document.getElementById('jet_alert_box');
	if (previousInformation && typeof previousInformation.jetCloseSchemeDialog === 'function') previousInformation.jetCloseSchemeDialog(false);
	const jetOfferStatus = (status) => {
		const messages = {
			loading: 'Преизчисляване…',
			unavailable: 'За избраните условия продуктите в количката не могат да бъдат закупени заедно на изплащане. Моля, изберете друг срок или условия.\n\nАко желаете, можете да закупите на изплащане всеки продукт поотделно.',
			invalid: 'Проверете въведените данни и преизчислете.',
			error: 'Финансирането не може да бъде изчислено. Натиснете „Преизчисли“, за да опитате отново.'
		};
		const message = messages[status] || '';
		if (status === 'unavailable') {
			$('#jet_offer_status').text('').prop('hidden', true);
			const state = jetCheckoutState();
			if (jetSchemeNoticeState !== state) {
				jetSchemeNoticeState = state;
				jetShowCustomAlert(message, false, true);
			}
			return;
		}
		$('#jet_offer_status').text(message).prop('hidden', !message);
	};
	const jetInvalidateOffer = () => {
		++jetCalculationRevision;
		jetCurrentOffer = null;
		if (jetCloseSchemeDialog) jetCloseSchemeDialog(false);
		if (jetSchemeNoticeState !== jetCheckoutState()) jetSchemeNoticeState = null;
		for (const field of ['priceall', 'total_credit_price', 'vnoska', 'vnoska_popup', 'gpr', 'glp', 'obshto']) {
			$('#jet_card_' + field).text('');
			$('#jet_card_' + field + '_second').text('');
		}
		$panel.find('.jet_offer_result').prop('hidden', false);
		$confirm.prop('disabled', true);
		jetOfferStatus(null);
	};
	const jetCalculate = () => {
		if (!jetPanelCurrent() || jetConfirmPending || jetConfirmNeedsReview) return;
		jetInvalidateOffer();
		const revision = jetCalculationRevision;
		const state = jetCheckoutState();
		const current = () => jetPanelCurrent() && revision === jetCalculationRevision && state === jetCheckoutState();
		const jetPriceall = parseFloat($('#jet_card_price').val());
		// Match the strict decimal grammar and whitespace accepted by PHP checkoutNumber().
		const rawDown = String($('#jet_card_parva').val() ?? '').replace(/^[ \t\n\r\x00\x0b]+|[ \t\n\r\x00\x0b]+$/g, '');
		const down = /^(?:[+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+))?$/.test(rawDown) ? Number(rawDown) : NaN;
		jetHideOptions401();
		jetHideOptions601();
		if (jetPriceall >= 401) jetShowOptions401();
		if (jetPriceall >= 601) jetShowOptions601();
		if (!Number.isFinite(down) || down < 0 || !(down < jetPriceall && down < Number(jetPriceall.toFixed(2)))) {
			jetOfferStatus('invalid');
			return;
		}
		const canonicalDown = down.toFixed(2);
		jetOfferStatus('loading');
		try {
			const jetFormData = new FormData();
			jetFormData.append('jet_checkout_context', 'jet_card');
			jetFormData.append('jet_priceall', jetPriceall.toFixed(2));
			jetFormData.append('jet_parva', canonicalDown);
			jetFormData.append('jet_vnoski', parseInt($('#jet_card_vnoski').val()));
			jetFormData.append('jet_products', $('#jet_card_products').val());
			jetFormData.append('jet_products_qt', $('#jet_card_products_qt').val());
			jetFormData.append('jet_products_pr', $('#jet_card_products_pr').val());
			$.ajax({
				url: 'index.php?route=extension/mt_jet_credit/jetcredit/jet_calculate_cart',
				method: 'POST',
				data: jetFormData,
				processData: false,
				contentType: false,
				timeout: 30000,
				success: function(json) {
					if (!current()) return;
					if (!json || json.success !== 'success') {
						jetOfferStatus(json && (json.jet_scheme_invalid === true || json.jet_promotion_excluded === true) ? 'unavailable' :
							(json && json.success === 'unsuccess' && !json.jet_quote_error ? 'invalid' : 'error'));
						return;
					}
					const term = parseInt($('#jet_card_vnoski').val(), 10);
					const fields = { priceall: 'jet_priceall', total_credit_price: 'jet_total_credit_price',
						vnoska: 'jet_vnoska_card', gpr: 'jet_gpr_card', glp: 'jet_glp_card', obshto: 'jet_obshto_card' };
					if (json.success !== 'success' || !Number.isInteger(term) || Number(json.jet_priceall) !== Number(jetPriceall.toFixed(2))
						|| !Object.values(fields).every(field => typeof json[field] === 'string' && json[field] !== '' && Number.isFinite(Number(json[field])))) {
						jetOfferStatus('error');
						return;
					}
					for (const [field, key] of Object.entries(fields)) $('#jet_card_' + field).text(json[key]);
					$('#jet_card_vnoski_text').text(term);
					$('#jet_card_vnoska_popup').text(json['jet_vnoska_card']);
					for (const field of ['priceall', 'total_credit_price', 'vnoska', 'vnoska_popup', 'obshto']) {
						const key = field === 'vnoska_popup' ? fields.vnoska : fields[field];
						$('#jet_card_' + field + '_second').text(json[key + '_second']);
					}
					jetSchemeNoticeState = null;
					jetCurrentOffer = { state: jetCheckoutState(), down: canonicalDown };
					$panel.find('.jet_offer_result').prop('hidden', false);
					jetOfferStatus(null);
					changeBtnJetcredit();
				},
				error: function() { if (current()) jetOfferStatus('error'); }
			});
		} catch (error) {
			if (current()) jetOfferStatus('error');
		}
	};

	const jetHideOptions401 = () => {
		$('#jet_card_vnoski').find('option').each(function() {
			if ($(this).val() === '15' || $(this).val() === '18' || $(this).val() === '24') {
				$(this).prop('disabled', true);
			}
		});
	}
	const jetShowOptions401 = () => {
		$('#jet_card_vnoski').find('option').each(function() {
			if ($(this).val() === '15' || $(this).val() === '18' || $(this).val() === '24') {
				$(this).prop('disabled', false);
			}
		});
	}
	const jetHideOptions601 = () => {
		$('#jet_card_vnoski').find('option').each(function() {
			if ($(this).val() === '30' || $(this).val() === '36') {
				$(this).prop('disabled', true);
			}
		});
	}
	const jetShowOptions601 = () => {
		$('#jet_card_vnoski').find('option').each(function() {
			if ($(this).val() === '30' || $(this).val() === '36') {
				$(this).prop('disabled', false);
			}
		});
	}
	
	const jetShowCustomAlert = (message, exit, information = false) => {
		if (information) {
			if (jetCloseSchemeDialog) jetCloseSchemeDialog(false);
			$('#jet_alert_box').remove();
		}
		const jetAlertBox = $('<div></div>', {
			id: 'jet_alert_box',
			css: {
				position: 'fixed',
				top: '50%',
				left: '50%',
				transform: 'translate(-50%, -50%)',
				backgroundColor: '#fff',
				padding: '20px',
				borderRadius: '5px',
				boxShadow: '0 0 10px rgba(0, 0, 0, 0.1)',
				zIndex: '5000001',
				width: '300px',
				textAlign: 'center'
			}
		});
		const returnFocus = document.activeElement;
		if (information) {
			jetAlertBox.attr({ role: 'dialog', 'aria-modal': 'true', 'aria-labelledby': 'jet_scheme_title',
				'aria-describedby': 'jet_scheme_message', 'data-jet-scheme-dialog': 'true' })
				.css({ width: '360px', maxWidth: 'calc(100vw - 32px)', maxHeight: 'calc(100vh - 32px)', overflowY: 'auto', boxSizing: 'border-box' });
			jetAlertBox.append($('<h3></h3>', { id: 'jet_scheme_title', text: 'Информация' }));
		}
		const jetMessageText = $('<p></p>', {
			text: message,
			css: {
				fontFamily: '"Roboto Condensed", sans-serif',
				color: '#14532d'
			}
		});
		if (information) jetMessageText.attr('id', 'jet_scheme_message').css('white-space', 'pre-line');
		jetAlertBox.append(jetMessageText);
		const jetCloseButton = $('<button></button>', {
			type: 'button',
			text: 'Добре',
			css: {
				fontFamily: '"Roboto Condensed", sans-serif',
				fontWeight: '500',
				marginTop: '20px',
				padding: '10px 20px',
				border: 'none',
				backgroundColor: '#166534',
				color: '#fff',
				borderRadius: '3px',
				cursor: 'pointer'
			}
		});
		jetCloseButton.on('click', function() {
			if (information) { jetCloseSchemeDialog(); return; }
			jetAlertBox.remove();
			if (exit) {
				window.location.href = window.location.origin;
			}
			$('#jet_alert_overlay').removeClass('show');
		});
		jetAlertBox.append(jetCloseButton);
		$('body').append(jetAlertBox);
		if (information) {
			let overlay = $('#jet_alert_overlay');
			const createdOverlay = !overlay.length;
			if (createdOverlay) overlay = $('<div>', { id: 'jet_alert_overlay', class: 'jet_alert_overlay' }).appendTo('body');
			overlay.appendTo('body').addClass('show').css({ display: 'block', position: 'fixed', top: 0, left: 0,
				width: '100%', height: '100%', backgroundColor: 'rgba(0, 0, 0, 0.5)', zIndex: 5000000 });
			jetCloseSchemeDialog = (restoreFocus = true) => {
				$(document).off('.jetSchemeDialog');
				jetAlertBox.remove();
				overlay.removeClass('show').css('display', '');
				if (createdOverlay) overlay.remove();
				jetCloseSchemeDialog = null;
				if (restoreFocus) {
					const controls = document.getElementById('jet_checkout_offer');
					const target = returnFocus && returnFocus.isConnected !== false && controls && controls.contains(returnFocus)
						? returnFocus : document.getElementById('jet_card_vnoski');
					if (target) target.focus();
				}
			};
			jetAlertBox[0].jetCloseSchemeDialog = jetCloseSchemeDialog;
			$(document).off('.jetSchemeDialog').on('keydown.jetSchemeDialog', (event) => {
				if (event.key === 'Escape' || event.key === 'Tab') {
					event.preventDefault(); event.stopImmediatePropagation();
					if (event.key === 'Escape') jetCloseSchemeDialog(); else jetCloseButton[0].focus();
				}
			}).on('focusin.jetSchemeDialog', (event) => {
				if (!jetAlertBox[0].contains(event.target)) jetCloseButton[0].focus();
			});
			jetCloseButton[0].focus();
		}

	}
	
	const changeBtnJetcredit = () => {
		$confirm.prop('disabled', jetConfirmPending || jetConfirmNeedsReview || !jetOfferCurrent()
			|| !(Number($('#jet_card_vnoska').text()) >= 20)
			|| !$('#jet_card_uslovia').is(':checked') || !$('#jet_card_uslovia1').is(':checked') || $('#jet_card_egn').val() === '');
	};

	$('#jet_card_egn').on('input', function() {
		this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);
		changeBtnJetcredit();
	});
	$('#jet_card_uslovia, #jet_card_uslovia1').on('change', changeBtnJetcredit);
	$('#btn_card_preizcisli').on('click', jetCalculate);
	$('#jet_card_parva').on('input change', () => { if (jetPanelCurrent()) jetInvalidateOffer(); });
	$('#jet_card_vnoski').on('change', () => {
		jetCalculate();
	});
	$(document).off('change.jetCheckoutSelection').on('change.jetCheckoutSelection', 'input[name="payment_method"]', function() {
		if (document.getElementById('jet_checkout_offer') !== $panel[0]) return;
		if (this.value !== 'jet_card') {
			jetInvalidateOffer();
		} else if (!jetOfferCurrent()) {
			jetCalculate();
		}
	});

	$confirm.on('click', function() {
		changeBtnJetcredit();
		if ($confirm.prop('disabled')) return;
		jetConfirmPending = true;
		let requestStarted = false;
		try {
		$confirm.prop('disabled', true).val($confirm.attr('data-loading-text') || jetConfirmLabel);
		const jetFormSendData = new FormData();
		jetFormSendData.append('jet_card_priceall', $('#jet_card_priceall').text());
		jetFormSendData.append('jet_card_vnoski', $('#jet_card_vnoski').val());
		jetFormSendData.append('jet_card_vnoska', $('#jet_card_vnoska').text());
		jetFormSendData.append('jet_card_parva', jetCurrentOffer.down);
		jetFormSendData.append('jet_card_total_credit_price', $('#jet_card_total_credit_price').text());
		jetFormSendData.append('jet_card_obshto', $('#jet_card_obshto').text());
		jetFormSendData.append('jet_card_gpr', $('#jet_card_gpr').text());
		jetFormSendData.append('jet_card_glp', $('#jet_card_glp').text());
		jetFormSendData.append('jet_card_egn', $('#jet_card_egn').val());
		jetFormSendData.append('jet_card_products', $('#jet_card_products').val());
		jetFormSendData.append('jet_card_products_qt', $('#jet_card_products_qt').val());
		jetFormSendData.append('jet_card_products_pr', $('#jet_card_products_pr').val());
		jetFormSendData.append('jet_card_products_vr', $('#jet_card_products_vr').val());
		requestStarted = true;
		$.ajax({
			url: 'index.php?route=extension/payment/jet_card/confirm',
			method: 'POST',
			data: jetFormSendData,
			processData: false,
			contentType: false,
			timeout: 30000,
			success: function(json) {
				if (!json || json.jet_submission_review === true || !['success', 'unsuccess'].includes(json.success) || json.code === 'bank_uncertain') {
					jetConfirmNeedsReview = true;
					alert('Резултатът от изпращането не е потвърден. Моля, свържете се с магазина за проверка.');
					return;
				}
				if (json.success === 'unsuccess' && (json.jet_quote_invalid === true || json.jet_quote_error === true || (!json.code && !json.order_id))) {
					if (jetPanelCurrent()) {
						jetInvalidateOffer();
						jetOfferStatus(json.jet_quote_error === true ? 'error' : (json.jet_scheme_invalid === true ? 'unavailable' : 'invalid'));
					}
					return;
				}
				if (json.success === 'success' || json.order_id) jetConfirmNeedsReview = true;
				console.log(json);
				if (json['success'] == 'success') {
					if (json['redirect']) {
						location = json['redirect'];
					}
				}else{
					$("#jet_card_alert_overlay").addClass("show");
					jetShowCustomAlert('Заявката за лизинг не може да бъде изпратена в момента! Моля опитайте по-късно.', false);
				}
			},
			error: function(xhr, ajaxOptions, thrownError) {
				jetConfirmNeedsReview = true;
				alert('Резултатът от изпращането не е потвърден. Моля, свържете се с магазина за проверка.');
			},
			complete: function() {
				jetConfirmPending = false;
				$confirm.val(jetConfirmLabel);
				changeBtnJetcredit();
			}
		});
		} catch (error) {
			jetConfirmPending = false;
			jetConfirmNeedsReview = requestStarted;
			$confirm.val(jetConfirmLabel);
			changeBtnJetcredit();
			alert(requestStarted ? 'Резултатът от изпращането не е потвърден. Моля, свържете се с магазина за проверка.' : 'Заявката за лизинг не може да бъде изпратена в момента! Моля опитайте по-късно.');
		}
	});
	
	jetCalculate();
});
//--></script>

				<option value="18" {% if jet_card_vnoski == 18 %}selected{% endif %}>18 месеца</option>
				<option value="24" {% if jet_card_vnoski == 24 %}selected{% endif %}>24 месеца</option>
				<option value="30" {% if jet_card_vnoski == 30 %}selected{% endif %}>30 месеца</option>
